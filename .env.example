# Copy to .env (git-ignored) and fill in. Load with: uv run --env-file .env <command>
# Never commit real values; gitleaks runs on every commit.

# --- Free routes for the pilot (docs/free-pilot-models.md) ---------------------------
# Google AI Studio key from a project WITHOUT billing (free tier; prompts are used by
# Google for training, so only public data goes here).
GEMINI_FREE_API_KEY=
# Groq free plan (no card): qwen/qwen3.8-27b.
GROQ_API_KEY=
# NVIDIA build (build.nvidia.com, no card): deepseek-ai/deepseek-v4.1-flash.
NVIDIA_API_KEY=
# Optional overflow for Qwen: Cloudflare Workers AI free plan.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Fanar (QCRI), access by request; ask for Fanar-2.0-Tools by name.
FANAR_API_KEY=
FANAR_MODEL=Fanar-2.0-Tools
# Set to any value to include a local Ollama model in the probes (OLLAMA_MODEL to choose).
OLLAMA_PROBE=
OLLAMA_MODEL=gpt-oss:20b
# Ollama Cloud API key (ollama.com/settings/keys): route ollama_cloud, gemma4:31b-cloud on the free plan.
OLLAMA_API_KEY=

# --- Paid routes, once funded ------------------------------------------------------
# OpenRouter: one key per phase with a credit limit and daily reset (plan §7).
OPENROUTER_API_KEY=
# A second Google project with billing (keep it separate: billing ends a project's free tier).
GEMINI_BILLED_API_KEY=

# --- Publishing ------------------------------------------------------------------------
# Hugging Face fine-grained token with write access to the afandem Space and dataset only.
HF_TOKEN=

# Directory of the later private contamination batch, kept OUTSIDE this repo (Phase 4).
AFANDEM_PRIVATE_DIR=
